<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pill_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/pill_green"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationIconTint="@android:color/white"
        app:title="Agregar Medicamento"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tipo -->
            <TextView
                style="@style/Pill.Label"
                android:layout_marginTop="0dp"
                android:text="Nuevo Medicamento" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleTipo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:checkedButton="@+id/btnPastilla"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/btnPastilla"
                    style="@style/Pill.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pastilla" />

                <Button
                    android:id="@+id/btnLiquido"
                    style="@style/Pill.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Líquido" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Foto -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFoto"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/pill_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/layoutFotoHint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="@color/pill_green" />

                    <TextView
                        android:id="@+id/tvFotoHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Tomar foto del medicamento\nPuede ser una foto de su caja"
                        android:textColor="#1C1B1F"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/progressFoto"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEliminarFondo"
                    style="@style/Pill.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Eliminar fondo" />

                <Button
                    android:id="@+id/btnVolverTomar"
                    style="@style/Pill.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Volver a tomar" />
            </LinearLayout>

            <!-- Nombre -->
            <TextView
                style="@style/Pill.Label"
                android:text="Nombre del medicamento" />

            <EditText
                android:id="@+id/etNombre"
                style="@style/Pill.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ej. Acetaminofén"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />

            <!-- Dosis -->
            <TextView
                android:id="@+id/tvLabelDosis"
                style="@style/Pill.Label"
                android:text="Dosis" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etDosis"
                    style="@style/Pill.Field"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="500"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <Spinner
                    android:id="@+id/spUnidad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.4"
                    android:background="@drawable/bg_field" />
            </LinearLayout>

            <!-- Pastillas por toma (solo pastilla) -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/togglePorToma"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:checkedButton="@+id/btnUna"
                app:selectionRequired="true"
                app:singleSelection="true">

                <Button
                    android:id="@+id/btnUna"
                    style="@style/Pill.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:text="1 pastilla"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnMedia"
                    style="@style/Pill.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:text="1/2 pastilla"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnDos"
                    style="@style/Pill.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="40dp"
                    android:text="2 pastillas"
                    android:textSize="12sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Existencia -->
            <TextView
                style="@style/Pill.Label"
                android:text="Cantidad en existencia" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLabelEnvases"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Blísteres"
                        android:textColor="@color/pill_green"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etEnvases"
                        style="@style/Pill.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="1"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvLabelPorEnvase"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="Pastillas c/u"
                        android:textColor="@color/pill_green"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/etPorEnvase"
                        style="@style/Pill.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="10"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <!-- Frecuencia y horario (pantalla pendiente) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardFrecuencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="@color/pill_green"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@android:drawable/ic_menu_recent_history"
                                app:tint="@android:color/white" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Frecuencia y horario"
                                android:textColor="@android:color/white"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFrecuenciaEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Sin configurar"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&gt;"
                        android:textColor="@android:color/white"
                        android:textSize="24sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cancelar / Guardar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelar"
                    style="@style/Pill.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Cancelar" />

                <Button
                    android:id="@+id/btnGuardar"
                    style="@style/Pill.ToggleButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/pill_green"
                    android:text="Guardar"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
