<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Colores tomados de tu activity_home.xml -->
    <color name="pill_bg">#E7E5DF</color>
    <color name="pill_green">#2D4D3A</color>
    <color name="pill_card">#D3D2CC</color>

    <style name="Pill.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/pill_green</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Pill.Field" parent="">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:textColor">#1C1B1F</item>
        <item name="android:textColorHint">#79747E</item>
        <item name="android:textSize">14sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="Pill.ToggleButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
